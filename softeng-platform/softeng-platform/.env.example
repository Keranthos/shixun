# 复制为 .env 后按本地环境修改
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
# 推荐：先执行 database/bootstrap_user.sql 创建 softeng_app，与下方默认一致
DB_USER=softeng_app
DB_PASSWORD=123456
DB_NAME=softeng

JWT_SECRET=change-me-to-a-long-random-string

# 可选：LangChain RAG（需 agent/ 服务已启动）
AGENT_BASE_URL=http://127.0.0.1:8766
AGENT_INTERNAL_TOKEN=
# 日常开发建议 false，避免每次起后端都尝试全量索引；索引空时管理员手动重建即可
AGENT_AUTO_REINDEX=false
RAG_RATE_LIMIT_PER_MIN=12

# 可选：Go 内置 RAG 回退（Agent 不可用时）
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
