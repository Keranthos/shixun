# 复制为 .env 后填入 GOOGLE_API_KEY
AGENT_HOST=0.0.0.0
AGENT_PORT=8766
INTERNAL_API_TOKEN=

CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=softeng_rag_v1

# Gemini：默认自动从 D:\blog\agent\.env 补齐（与 blog 相同，无需重复填写）
# 仅需在 blog 配好 GEMINI_API_BASE + GEMINI_PROXY_TOKEN + GOOGLE_API_KEY 即可
# 若 blog 不在 D:\blog，可设 BLOG_AGENT_ENV=你的路径\blog\agent\.env
GOOGLE_API_KEY=
GEMINI_API_BASE=
GEMINI_PROXY_TOKEN=
# 仅当 GEMINI_API_BASE 为 Google 官方域名且国内直连时再用：
# GEMINI_HTTPS_PROXY=http://127.0.0.1:7890
GEMINI_EMBED_MODEL=models/gemini-embedding-001
# 每批 embedding 条数（默认 16；语料大时可试 32，注意 429 限流）
GEMINI_EMBED_BATCH_SIZE=16
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

AGENT_PERSONA_PATH=./app/persona/softeng_assistant.md
SITE_FACTS=软工资源平台面向学院师生，聚合工具、课程与项目三类学习资源。
